{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "uv run ../../.claude/status_lines/minimal.py",
    "padding": 0
  },
  "permissions": {
    "deny": [
      "Bash(*)",
      "mcp__ide__executeCode",
      "mcp__ide__getDiagnostics"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/whitelist.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
